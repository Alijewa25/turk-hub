# Runtime environment: use "production" on Render.
ENV=development

# PostgreSQL connection string. Leave empty locally to use SQLite.
DATABASE_URL=

# Required in production; use a long random value.
SECRET_KEY=
ADMIN_EMAIL=

# Comma-separated browser origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173,http://localhost:3000,http://127.0.0.1:3000,https://turk-hub.vercel.app

# Optional Cloudinary persistent media storage (for Render / ephemeral hosts)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
